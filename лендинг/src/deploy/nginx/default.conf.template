log_format safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
limit_req_zone $binary_remote_addr zone=login:5m rate=5r/m;
limit_req_zone $binary_remote_addr zone=register:5m rate=2r/m;
limit_req_zone $binary_remote_addr zone=public_submit:5m rate=3r/m;
map $status $retry_after { default ''; 429 60; }
map "${ENABLE_HSTS}" $hsts { default ''; 1 'max-age=31536000'; }
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    access_log /dev/stdout safe;
    # nginx error logs can include raw request args. Suppress request-level logs.
    error_log /dev/stderr crit;
    client_max_body_size 64k;
    set_real_ip_from 192.168.1.47;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    limit_req_status 429;
    error_page 413 = @too_large;
    error_page 429 = @rate_limited;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security $hsts always;
    add_header Retry-After $retry_after always;
    # Server scope preserves security-header inheritance in all API/error locations.
    add_header Cache-Control "no-store" always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    gzip off;
    location @too_large {
        default_type application/json;
        return 413 '{"code":"PAYLOAD_TOO_LARGE"}';
    }
    location @rate_limited {
        default_type application/json;
        return 429 '{"code":"RATE_LIMITED"}';
    }
    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://api:8080;
    }
    location = /api/v1/auth/register {
        limit_req zone=register burst=2 nodelay;
        proxy_pass http://api:8080;
    }
    location = /api/v1/public/applications {
        limit_req zone=public_submit burst=3 nodelay;
        proxy_pass http://api:8080;
    }
    location /api/ { proxy_pass http://api:8080; }
    location / { try_files $uri $uri/ /index.html; }
}
