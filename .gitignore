# Deploy private material: secrets, backups, per-env dotenvs (F4-03).
# Exact + glob forms; .env.example stays tracked via the negation above and below.
deploy/secrets*/
deploy/backups*/
deploy/.env
deploy/.env.test
deploy/.env.demo
!deploy/.env.example

# Key/credential material — never track any of it.
*.age
*.key
age-identity*
pgpass*

# Local agent/plan artifacts, never part of the published repo.
.sisyphus/
evidence/
