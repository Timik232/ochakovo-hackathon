# Copy to deploy/.env, chmod 600; NEVER include it in source archives/evidence.
IMAGE_TAG=UNRELEASED
# T12 pins this to postgres:17@sha256:<verified-digest>.
DB_IMAGE=postgres:17
POSTGRES_DB=ochakovo_candidates
POSTGRES_USER=ochakovo
POSTGRES_PASSWORD=CHANGE_ME
# URL-encode password here; components MUST match POSTGRES_* above.
DATABASE_URL=postgresql+psycopg://ochakovo:CHANGE_ME@db:5432/ochakovo_candidates
TEST_DATABASE_URL=postgresql+psycopg://ochakovo:CHANGE_ME@db:5432/ochakovo_candidates_test
APP_ORIGIN=https://ochakovo.komolov.synology.me
# Defaults secure; only APP_ENV=test/development honor explicit false. Production forces true.
COOKIE_SECURE=true
# Stable secret >=32 UTF-8 bytes. Empty fails closed; provision outside repo.
SUBMISSION_HMAC_SECRET=
INGRESS_PORT=18120
# Enable ONLY after verified HTTPS; prefer HSTS on Synology itself.
ENABLE_HSTS=0
TZ=Europe/Moscow
# Public age recipient only (age1...), NOT private identity.
BACKUP_AGE_RECIPIENT=
# Private identity on OPERATOR machine; only mount during isolated restore.
BACKUP_AGE_KEY_FILE=/run/secrets/age-identity
BACKUP_RETENTION_DAYS=14
# Host files: UID 10001 readable, mode 0600, no PGPASSWORD argv.
PGPASS_HOST_FILE=./secrets/pgpass
TEST_PGPASS_HOST_FILE=./secrets/pgpass-test
# Runtime overrides for isolated restore only: TARGET_DB=restore-drill,
# PGHOST/PGPORT/PGUSER/PGDATABASE, PRODUCTION_DB_NAME, FORCE_RESTORE_TO.
# FORCE_RESTORE_TO never bypasses mandatory restore-* target naming.
